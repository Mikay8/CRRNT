{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false,
        "buildConfiguration": "Debug",
        "image": "sdk-58"
      }
    },
    "simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true,
        "buildConfiguration": "Debug",
        "image": "sdk-58"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "buildConfiguration": "Release",
        "image": "sdk-58"
      },
      "env": {
        "EXPO_PUBLIC_DOMAIN": "api-server-production-1079.up.railway.app"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_DOMAIN": "api-server-production-1079.up.railway.app"
      },
      "ios": {
        "image": "sdk-58"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
